{
  "buildCommand": "npm run build:partner",
  "outputDirectory": "dist",
  "env": {
    "VITE_APP": "partner",
    "VITE_USE_MOCK": "false",
    "VITE_API_BASE_URL": "https://repair-buddy.onrender.com/api"
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
