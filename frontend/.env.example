# Set to 'true' to run fully offline with in-browser mock backend and 25 seeded workers
# Set to 'false' to communicate with the FastAPI backend
VITE_USE_MOCK=true

# Base URL for FastAPI backend (used when VITE_USE_MOCK=false)
VITE_API_BASE_URL=http://localhost:8000/api

# Firebase Web App Public Configuration (Phone Authentication)
# For demo/test mode without SMS cost, add test phone numbers in Firebase Console > Authentication > Phone > Phone numbers for testing
# Example test number: +91 98201 11222 | Test OTP: 123456
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
