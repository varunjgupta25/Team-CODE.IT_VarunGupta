# Production Environment Configuration for Vercel Deployment

# Set to false to connect to the live deployed FastAPI backend on Render
VITE_USE_MOCK=false

# Full public HTTPS URL to your Render backend service, ending with /api
VITE_API_BASE_URL=https://<render-service>.onrender.com/api

# Firebase Web App Public Configuration (Phone Authentication)
# Obtain these from Firebase Console > Project Settings > General > Your Apps (Web)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
