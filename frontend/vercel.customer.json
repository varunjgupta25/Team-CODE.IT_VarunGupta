{
  "buildCommand": "npm run build:customer",
  "outputDirectory": "dist/customer",
  "env": {
    "VITE_APP": "customer",
    "VITE_USE_MOCK": "false",
    "VITE_API_BASE_URL": "https://repair-buddy.onrender.com/api"
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
