# Repair Buddy Backend Environment Configuration
PROJECT_NAME="Repair Buddy API"
ENV="development"
ENVIRONMENT="development"
PORT=8000
HOST="0.0.0.0"

# CORS Configuration (comma-separated origins)
# In development, localhost defaults are automatically provided.
# In production, explicit origins must be specified (wildcard '*' is forbidden).
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
# Optional regex pattern for preview deployment origins (e.g. Vercel preview URLs)
CORS_ORIGIN_REGEX="https://.*\.vercel\.app"

# Auto-seed mock database on startup if workers collection is empty
AUTO_SEED="true"

# Database & Firebase Admin Configuration
# 1. Provide service account JSON string (preferred for cloud platforms like Render):
FIREBASE_CREDENTIALS_JSON=""
# 2. Or provide path to service account json key file:
FIREBASE_CREDENTIALS_PATH=""
# 3. Optional GCP project id for ApplicationDefault credentials:
FIRESTORE_PROJECT_ID=""
# 4. In development/testing, set to "true" for isolated in-memory Firestore; set to "false" in production:
USE_MOCK_FIREBASE="true"

# Transit Speed for ETA Calculation in km/h (PRD: 25 km/h)
TRANSIT_SPEED_KMH=25.0
