# Repair Buddy Backend Environment Configuration
PROJECT_NAME="Repair Buddy API"
ENV="development"
PORT=8000
HOST="0.0.0.0"

# CORS Configuration
# Comma-separated list of exact allowed origins
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
# Optional regex pattern for preview deployment origins (e.g. Vercel preview URLs)
CORS_ORIGIN_REGEX="https://.*\.vercel\.app"

# Auto-seed mock database on startup if workers collection is empty
AUTO_SEED="true"

# Firebase Configuration
# Path to service account json key file. If omitted or file not found, local mock Firestore mode is used automatically.
FIREBASE_CREDENTIALS_PATH=""
USE_MOCK_FIREBASE="true"

# Transit Speed for ETA Calculation in km/h (PRD: 25 km/h)
TRANSIT_SPEED_KMH=25.0
