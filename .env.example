# Repair Buddy Backend Environment Configuration
PROJECT_NAME="Repair Buddy API"
ENV="development"
PORT=8000
HOST="0.0.0.0"

# CORS Configuration
# Comma-separated list of exact allowed origins
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
# Optional regex pattern for preview deployment origins (e.g. Vercel preview URLs)
CORS_ORIGIN_REGEX="https://.*\.vercel\.app"

# Auto-seed mock database on startup if workers collection is empty
AUTO_SEED="true"

# Firebase Configuration
# Production uses FIREBASE_CREDENTIALS_JSON (full service account JSON string, ideal for Render/Vercel)
# Local development fallback uses FIREBASE_CREDENTIALS_PATH (local file path)
FIREBASE_CREDENTIALS_JSON=""
FIREBASE_CREDENTIALS_PATH=""
USE_MOCK_FIREBASE="true"

# Auto-confirm window for awaiting_confirmation jobs (in hours, default 48)
AUTO_CONFIRM_HOURS=48.0

# Transit Speed for ETA Calculation in km/h (PRD: 25 km/h)
TRANSIT_SPEED_KMH=25.0

# Private Object Storage Configuration (DPDP compliant)
# Uploads are saved in private storage, never exposed publicly, and purged upon decision
PRIVATE_STORAGE_PATH="data/private_uploads"
FIREBASE_STORAGE_BUCKET=""

# Emergency SOS Alerting & Notification Provider
# India SMS requires DLT (Distributed Ledger Technology) template registration.
# For demo and hackathons, Twilio WhatsApp or ConsoleProvider (dev) is the recommended path.
NOTIFICATION_PROVIDER="console" # "console" | "twilio"
OPS_ALERT_PHONE="+919800000000"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_PHONE=""
TWILIO_WHATSAPP_FROM=""
